# sqlite = local demo; firestore = Firebase-connected API
STORE_MODE=sqlite
SQLITE_PATH=tokenflow.db
FRONTEND_ORIGIN=http://localhost:5173
# Generate a long random value. Required for consistent sessions across restarts/workers.
SECRET_KEY=
SIMULATION_ENABLED=true
PORT=5000
# Firebase mode: path to a service account file OUTSIDE the source repository
GOOGLE_APPLICATION_CREDENTIALS=
# Optional SMS adapter credentials (backend only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
