# api = shared Flask/SQLite; firebase = Flask/Firestore; showcase = browser-only account demo
# demo = browser-only simulated data; Admin accepts any valid-format email and non-empty password.
# Do not use demo mode for production deployments.
VITE_APP_MODE=api
# /api works with Flask serving dist, or the Vite development proxy.
VITE_API_URL=/api
# Optional publicly reachable frontend origin for branch QR links.
VITE_PUBLIC_ORIGIN=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
