# Netlify site environment variables (Site configuration > Environment variables).
# For `netlify dev`, copy to .env in the repo root. Never commit real values.

# Signs session tokens and QR share links. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the function generates one and stores it in Netlify Blobs.
SECRET_KEY=

# One-time key that lets you create the first admin account from the Admin page.
# Leave empty to disable admin setup. Remove it after the admin has been created.
ADMIN_SETUP_KEY=

# "true" lets admins add simulated visitors from the dashboard (default: true).
SIMULATION_ENABLED=true

# Optional: origin used in QR share links. Defaults to the site URL Netlify provides.
PUBLIC_ORIGIN=
